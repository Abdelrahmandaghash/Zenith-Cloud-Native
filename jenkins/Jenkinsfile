pipeline {
    agent any

    environment {
        APP_NAME     = 'zenith-platform'
        COMPOSE_FILE = 'docker-compose.yml'
        ENVIRONMENT  = 'local-staging'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo '=== Stage 1: Fetching latest code from repository ==='
                checkout scm
            }
        }

        stage('2. Static Checks & Tests') {
            steps {
                echo '=== Stage 2: Running backend syntax checks & verification script ==='
                sh '''
                    PYTHON_BIN=$(command -v python3 || command -v python)
                    $PYTHON_BIN -m py_compile services/product-service/main.py services/tour-service/main.py services/order-service/main.py
                    $PYTHON_BIN scripts/verify_all.py
                '''
            }
        }

        stage('3. Build Frontend') {
            steps {
                echo '=== Stage 3: Installing frontend dependencies & building React production bundle ==='
                dir('frontend') {
                    sh '''
                        if command -v npm >/dev/null 2>&1; then
                          npm ci
                          npm run build
                        else
                          echo "npm not installed on agent; skipping frontend build"
                        fi
                    '''
                }
            }
        }

        stage('4. Build Docker Images') {
            steps {
                echo '=== Stage 4: Building container images via Docker Compose ==='
                sh '''
                    docker compose build --parallel
                '''
            }
        }

        stage('5. Deploy Local Stack') {
            steps {
                echo '=== Stage 5: Deploying microservices container stack ==='
                sh '''
                    docker compose down --remove-orphans || true
                    docker compose up -d
                '''
            }
        }

        stage('6. Smoke Tests & Verification') {
            steps {
                echo '=== Stage 6: Running health checks against deployed microservices ==='
                sh '''
                    set -e
                    sleep 10
                    echo "Checking Gateway health..."
                    curl -s -f http://localhost:80/gateway-health

                    echo "Checking Product Service..."
                    curl -s -f http://localhost:8001/health

                    echo "Checking Tour Service..."
                    curl -s -f http://localhost:8002/health

                    echo "Checking Order Service..."
                    curl -s -f http://localhost:8003/health
                '''
            }
        }
    }

    post {
        success {
            echo '=================================================='
            echo ' ZENITH CI/CD Pipeline Succeeded!'
            echo ' Platform accessible at: http://localhost:80'
            echo ' Prometheus: http://localhost:9090'
            echo ' Grafana: http://localhost:3001 (admin/admin)'
            echo '=================================================='
        }
        failure {
            echo '=================================================='
            echo ' Pipeline failed! Review logs above for details.'
            echo '=================================================='
        }
    }
}
